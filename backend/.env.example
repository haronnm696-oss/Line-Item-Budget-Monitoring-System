APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lib_monitoring_system
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# TLS (TiDB Cloud, port 4000): DB_SSL=true verifies against the system CA
# bundle. On Windows, point DB_SSL_CA at a PEM bundle, e.g.
# C:\xampp\apache\bin\curl-ca-bundle.crt. See DEPLOYMENT.md section 1.
DB_SSL=false
# DB_SSL_CA=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local

# Where uploaded documents (receipts, invoices, quotations, payroll files) are
# stored. "database" (default): file bytes go into the document_contents table
# (MEDIUMBLOB), so they survive redeploys on hosts whose disk is wiped, such
# as Render's free instance. Or a Laravel disk name: "local" (storage/app) or
# "documents_s3" (config/filesystems.php). Files already stored on a disk are
# still read from that disk; copy them with
#   php artisan documents:import-to-database --dry-run   (then without --dry-run)
# Uploads: PDF, JPG or PNG, up to 5 MB each.
DOCUMENTS_DISK=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
# Used only when MAIL_MAILER=brevo (production on Render). No real key here.
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Render / production ---
# Set these in the Render dashboard. Do not commit real secrets.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-app.vercel.app
# LOG_CHANNEL=stderr
# SESSION_DRIVER=database
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app,lib-monitoring-api.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# DB_SSL=true   (TiDB Cloud Starter; leave AIVEN_CA_CERT_BASE64 unset)
# Legacy Aiven only:
# AIVEN_CA_CERT_BASE64=<base64 of ca.pem>  (optional: a CA cert is bundled at /var/www/html/ca.pem)
# MYSQL_ATTR_SSL_CA=/tmp/aiven-ca.pem

# --- Mail (password reset, registration review, account setup) ---
# Render production: Render's free tier blocks SMTP ports (25/465/587), so mail
# goes through Brevo's HTTPS API. Replace placeholders; never commit a real key.
# The sender address must be verified in Brevo (Senders, Domains & IPs).
# MAIL_MAILER=brevo
# BREVO_API_KEY=<brevo-api-key>
# MAIL_FROM_ADDRESS=no-reply@<your-verified-domain>
# MAIL_FROM_NAME="LIB Monitoring System"
# FRONTEND_URL=https://<your-app>.vercel.app
#
# Local testing only: MAIL_MAILER=log writes the reset link to
# storage/logs/laravel.log. Never use log mode in production.


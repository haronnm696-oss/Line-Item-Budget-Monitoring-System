APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lib_monitoring_system
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local

# Where uploaded documents (receipts, invoices, quotations, payroll files) are
# stored. "database" (default): file bytes go into the document_contents table
# (MEDIUMBLOB), so they survive redeploys on hosts whose disk is wiped, such
# as Render's free instance. Or a Laravel disk name: "local" (storage/app) or
# "documents_s3" (config/filesystems.php). Files already stored on a disk are
# still read from that disk; copy them with
#   php artisan documents:import-to-database --dry-run   (then without --dry-run)
# Uploads: PDF, JPG or PNG, up to 5 MB each.
DOCUMENTS_DISK=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Render / production ---
# Set these in the Render dashboard. Do not commit real secrets.
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-app.vercel.app
# LOG_CHANNEL=stderr
# SESSION_DRIVER=database
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app,lib-monitoring-api.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# AIVEN_CA_CERT_BASE64=<base64 of ca.pem>  (optional: a CA cert is bundled at /var/www/html/ca.pem)
# MYSQL_ATTR_SSL_CA=/tmp/aiven-ca.pem

# --- Password reset mail ---
# Render production (replace placeholders; never commit real credentials):
# MAIL_MAILER=smtp
# MAIL_HOST=<smtp-host>
# MAIL_PORT=587
# MAIL_USERNAME=<smtp-username>
# MAIL_PASSWORD=<smtp-password>
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@<your-domain>
# MAIL_FROM_NAME="LIB Monitoring System"
# FRONTEND_URL=https://<your-app>.vercel.app
#
# Local testing only: MAIL_MAILER=log writes the reset link to
# storage/logs/laravel.log. Never use log mode in production.

# --- Payroll deduction rates (read by config/payroll.php) ---
# Leave every value EMPTY until the official values are provided. The
# official rates, employee shares, salary floors / ceilings and tax brackets
# must come from the MSU accounting office; do not copy them from the
# internet or an old payroll. Nothing is assumed: an empty or invalid value
# means "not set", that deduction is 0.00, and the Payroll page shows
# "Deduction rates are not set yet. Ask your Program Leader or Finance/Admin."
#
# A percent deduction counts as set only when BOTH its _RATE and its
# _EMPLOYEE_SHARE are given:
#   _RATE            percent of the monthly rate (a value of N means N%)
#   _EMPLOYEE_SHARE  part paid by the employee, from 0 to 1 (1 = all of it)
#   _BASE_MIN        optional salary floor (empty = no floor)
#   _BASE_MAX        optional salary ceiling (empty = no ceiling)
#
# PAYROLL_WITHHOLDING_TAX_BRACKETS: one line of JSON, wrapped in single quotes,
#   '[{"over": <amount>, "base_tax": <amount>, "rate": <percent>}, ...]'
# applied to taxable pay (gross minus GSIS, PhilHealth and Pag-IBIG):
# base_tax + rate% of the part above "over", using the highest bracket the
# pay exceeds. A malformed list is ignored (treated as not set).
#
# After a change: `php artisan config:clear` locally; on Render, set them in
# the service environment and redeploy (the config is cached). Draft or
# returned payroll already computed needs "Recompute".
PAYROLL_GSIS_RATE=
PAYROLL_GSIS_EMPLOYEE_SHARE=
PAYROLL_GSIS_BASE_MIN=
PAYROLL_GSIS_BASE_MAX=

PAYROLL_PHILHEALTH_RATE=
PAYROLL_PHILHEALTH_EMPLOYEE_SHARE=
PAYROLL_PHILHEALTH_BASE_MIN=
PAYROLL_PHILHEALTH_BASE_MAX=

PAYROLL_PAGIBIG_RATE=
PAYROLL_PAGIBIG_EMPLOYEE_SHARE=
PAYROLL_PAGIBIG_BASE_MIN=
PAYROLL_PAGIBIG_BASE_MAX=

PAYROLL_WITHHOLDING_TAX_BRACKETS=

# PAYROLL_RATES_LABEL: optional warning for non-official rates, e.g.
#   PAYROLL_RATES_LABEL="Demo deduction rates, not official"
# When set, every Payroll page shows it as a warning banner and the Payroll
# register (PDF and CSV) prints it at the top. Leave EMPTY in production
# once the official rates are in place.
PAYROLL_RATES_LABEL=

# Laravel backend base URL (Sanctum SPA auth expects same-site or configured
# stateful domains — see backend/config/sanctum.php SANCTUM_STATEFUL_DOMAINS).
# On Vercel, set VITE_API_URL=/ in the project environment variables so calls
# go through the same-origin proxy in vercel.json.
VITE_API_URL=http://localhost:8000

# Set to true to run the frontend against src/data/mockData.js only, with no
# network calls at all — useful before the backend controllers exist, or for
# offline UI work. Set to false once the API endpoints in src/api/endpoints.js
# are implemented.
VITE_USE_MOCK=false
